@using StudentEduApp.DataClass
@model IEnumerable<Performans>
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Öğrenci Yönetim Paneli</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <style>
        body {
            background-color: #f4f7f6;
            font-family: 'Inter', sans-serif;
            color: #333;
        }
        .container {
            margin-top: 50px;
        }
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        }
        .table {
            margin-bottom: 0;
        }
        .table thead th {
            background-color: #f8f9fa;
            border-bottom: 2px solid #eee;
            color: #666;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            padding: 15px;
        }
        .table tbody td {
            padding: 15px;
            vertical-align: middle;
            border-bottom: 1px solid #eee;
        }
        .avatar-circle {
            width: 40px;
            height: 40px;
            background-color: #6366f1;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-weight: bold;
            margin-right: 12px;
        }
        .badge-active {
            background-color: rgba(25, 135, 84, 0.1);
            color: #198754;
            border: 1px solid rgba(25, 135, 84, 0.2);
        }
        .badge-passive {
            background-color: rgba(220, 53, 69, 0.1);
            color: #dc3545;
            border: 1px solid rgba(220, 53, 69, 0.2);
        }
        .btn-action {
            padding: 5px 10px;
            border-radius: 8px;
            transition: 0.2s;
        }
        .btn-action:hover {
            background-color: #f0f0f0;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="page-header">
        <div>
            <h2 class="fw-bold mb-1">Performans Listesi</h2>
            <a href="/Ogrenci/Create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm"><i class="bi bi-plus-lg me-2"></i>Performans Ekle</a>
        </div>
    </div>

    <div class="card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                         <th>@Html.DisplayNameFor(m => m.PerformansId)</th>
                        <th>@Html.DisplayNameFor(m => m.OrtalamaNot)</th>
                        <th>@Html.DisplayNameFor(m => m.DevamYuzdesi)</th>
                        <th>@Html.DisplayNameFor(m => m.BasariSeviyesi)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var performans in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => performans.PerformansId)</td>
                            <td>@Html.DisplayFor(modelItem => performans.OrtalamaNot)</td>
                            <td>@Html.DisplayFor(modelItem => performans.DevamYuzdesi)</td>
                            <td>@Html.DisplayFor(modelItem => performans.BasariSeviyesi)</td>
                            <td>
                                <a asp-controller="Performans" asp-action="Edit" asp-route-id="@performans.PerformansId" class="btn btn-sm btn-outline-primary btn-action"><i class="bi bi-pencil"></i>Güncelle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>