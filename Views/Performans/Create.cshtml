@model Performans
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0"><i class="bi bi-person-badge me-2"></i>Öğrenci Performans Kaydı</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-4">
                            <label asp-for="OrtalamaNot" class="form-label fw-bold text-secondary">Ortalama Not</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-mortarboard"></i></span>
                                <input type="number" class="form-control" id="OrtalamaNot" asp-for="OrtalamaNot" placeholder="0-100 arası" min="0" max="100">
                            </div>
                            <div class="form-text">Öğrencinin genel akademik not ortalaması.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DevamYuzdesi" class="form-label fw-bold text-secondary">Devam Yüzdesi (%)</label>
                            <div class="d-flex align-items-center">
                                <input type="range" class="form-range flex-grow-1" id="DevamYuzdesi" asp-for="DevamYuzdesi" min="0" max="100" oninput="this.nextElementSibling.value = this.value">
                                <output class="badge bg-info ms-3" style="min-width: 45px;">50</output>
                            </div>
                            <div class="form-text">Derslere katılım oranı.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BasariSeviyesi" class="form-label fw-bold text-secondary">Başarı Seviyesi</label>
                            <select class="form-select shadow-none" id="BasariSeviyesi" asp-for="BasariSeviyesi">
                                <option selected disabled>Seviye seçiniz...</option>
                                <option value="1">Başlangıç (1)</option>
                                <option value="2">Orta (2)</option>
                                <option value="3">İyi (3)</option>
                                <option value="4">Çok İyi (4)</option>
                                <option value="5">Üstün Başarı (5)</option>
                            </select>
                        </div>

                        <hr class="my-4 text-muted">

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                <i class="bi bi-check2-circle me-2"></i>Verileri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">