@using StudentEduApp.DataClass
@model Ogrenci
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kayıt Formu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
     <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Inter', sans-serif;
        }
        .form-container {
            max-width: 500px;
            margin: 50px auto;
        }
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        .card-header {
            background-color: #6366f1;
            color: white;
            border-radius: 15px 15px 0 0 !important;
            padding: 20px;
            text-align: center;
        }
        .form-control:focus, .form-select:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 0.25 darkred; /* Subtle focus ring */
            box-shadow: 0 0 0 0.25rem rgba(99, 102, 241, 0.25);
        }
        .btn-primary {
            background-color: #6366f1;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s;
        }
        .btn-primary:hover {
            background-color: #4f46e5;
            transform: translateY(-2px);
        }
        .form-check-input:checked {
            background-color: #6366f1;
            border-color: #6366f1;
        }
    </style>
</head>
<body>

<div class="container form-container">
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Öğrenci Kayıt</h4>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-controller="Ogrenci" asp-action="Create">
                <div class="mb-3">
                    <label asp-for="AdSoyad" class="form-label fw-bold">Ad Soyad</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                        <input asp-for="AdSoyad" type="text" class="form-control" id="fullName" placeholder="Örn: Ahmet Yılmaz" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Bolum" class="form-label fw-bold">Bölüm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                        <input asp-for="Bolum" type="text" class="form-control" id="fullName" placeholder="Örn:Bilgisayar Mühendisliği" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="AktiflikDurumu" class="form-label fw-bold">Aktiflik Durumu</label>
                    <div class="form-check">
                        <input asp-for="AktiflikDurumu" class="form-check-input" type="checkbox" role="switch" id="activeStatus">
                        <label class="form-check-label" asp-for="AktiflikDurumu">Öğrenci aktifliği</label>
                    </div>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-2"></i>Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>