@using StudentEduApp.DataClass
@model Ogrenci
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Öğrenci Kaydı Sil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #fcfcfc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .delete-card {
            max-width: 500px;
            margin: 80px auto;
            border: none;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }
        .card-body {
            padding: 40px;
            text-align: center;
        }
        .warning-icon {
            font-size: 4rem;
            color: #dc3545;
            margin-bottom: 20px;
            display: inline-block;
            animation: pulse 2s infinite;
        }
       
        }
        .student-info-box {
            background-color: #fff5f5;
            border: 1px dashed #feb2b2;
            border-radius: 12px;
            padding: 15px;
            margin: 20px 0;
        }
        .btn-delete {
            background-color: #dc3545;
            border: none;
            padding: 12px;
            font-weight: 600;
            border-radius: 10px;
            transition: 0.3s;
        }
        .btn-delete:hover {
            background-color: #a71d2a;
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
        }
        .btn-cancel {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            padding: 12px;
            border-radius: 10px;
            font-weight: 500;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="card delete-card">
        <div class="card-body">
            <div class="warning-icon">
                <i class="bi bi-exclamation-octagon-fill"></i>
            </div>
           
            <h2>@Model.AdSoyad </h2>isimli öğrencinin kaydını silmek istediğinize emin misiniz?
            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@Model.Id">
                
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-delete text-white">
                        <i class="bi bi-trash3-fill me-2"></i>Evet
                    </button>
                    <a asp-action="List" class="btn btn-cancel text-secondary">
                        Hayır
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

</body>
</html>