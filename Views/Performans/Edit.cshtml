@using StudentEduApp.DataClass
@model Performans
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Performans Güncelleme</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        body {
            background-color: #f8f0f0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .update-card {
            max-width: 550px;
            margin: 60px auto;
            border: none;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }
        .card-header-custom {
            background: linear-gradient(135deg, #ff9a1d 0%, #ff5e3a 100%);
            color: white;
            border-radius: 20px 20px 0 0 !important;
            padding: 25px;
            text-align: center;
        }
        .form-label {
            font-weight: 600;
            font-size: 0.9rem;
            color: #555;
        }
        .form-control, .form-select {
            padding: 12px;
            border-radius: 10px;
            border: 1px solid #e0e0e0;
            background-color: #fdfdfd;
        }
        .form-control:focus {
            box-shadow: 0 0 0 4px rgba(255, 154, 29, 0.15);
            border-color: #ff9a1d;
        }
        .btn-update {
            background: linear-gradient(135deg, #ff9a1d 0%, #ff5e3a 100%);
            border: none;
            padding: 12px;
            font-weight: 600;
            border-radius: 10px;
            transition: all 0.3s ease;
        }
        .btn-update:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 94, 58, 0.3);
        }
        .status-box {
            border: 2px solid #eee;
            border-radius: 12px;
            padding: 15px;
            transition: 0.3s;
        }
        .status-box.active {
            border-color: #28a745;
            background-color: rgba(40, 167, 69, 0.05);
        }
    </style>
</head>
<body>

<div class="container">
    <div class="card update-card">
        <div class="card-header-custom">
            <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Performan Bilgilerini Güncelle</h4>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-controller="Ogrenci" asp-action="Edit">
                <input type="hidden" asp-for="PerformansId" />
                <div class="mb-3">
                    <label asp-for="OrtalamaNot" class="form-label">OrtalamaNot</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-person text-orange"></i></span>
                        <input asp-for="OrtalamaNot" class="form-control"  required>
                    </div>
                </div>

                <div class="mb-3">
                      <label asp-for="DevamYuzdesi" class="form-label">DevamYuzdesi</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-person text-orange"></i></span>
                        <input asp-for="DevamYuzdesi" class="form-control"  required>
                    </div>
                        
                    
                </div>

                <div class="mb-4">
                    <label asp-for="BasariSeviyesi" class="form-label d-block">Başarı Seviyesi</label>
                    <div class="status-box active d-flex justify-content-between align-items-center">
                        <div class="form-check form-switch mb-0">
                            <input class="form-control" asp-for="BasariSeviyesi">
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-md-8">
                        <button type="submit" class="btn btn-update btn-primary w-100 text-white">
                            <i class="bi bi-save me-2"></i>Değişiklikleri Kaydet
                        </button>
                    </div>
                    <div class="col-md-4">
                        <a href="liste.html" class="btn btn-light w-100 border p-2" style="border-radius: 10px;">
                            İptal
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
</body>
</html>