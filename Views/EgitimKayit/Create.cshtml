@using StudentEduApp.DataClass
@model EgitimKayit
<h2>Eğitim Kayıt Ekle</h2>
<hr />
<form asp-controller="EgitimKayit" asp-action="Create" method="post">
<div class="mb-3">
    <label asp-for="OgrenciId" class="form-label">Öğrenci</label>
    <select asp-for="OgrenciId"asp-items="ViewBag.Ogrenciler" class="form-control" >
        <option value="">Seçiniz</option>
    </select> 
</div>
<div class="mb-3">
    <label asp-for="EgitimModulId" class="form-label">Eğitim</label>
    <select  asp-for="EgitimModulId"asp-items="ViewBag.EgitimModulleri" class="form-control" >
        <option value="">Seçiniz</option>
    </select>
</div>
<button type="submit" class="btn btn-secondary">Kaydet</button>
</form>